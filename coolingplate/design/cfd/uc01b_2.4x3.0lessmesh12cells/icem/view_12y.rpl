# GUI: import the 12-unit Y mesh. No -batch. Do not remesh.
set msh {D:/agents2026/agents2026/agents/AIDCtms/coolingplate/design/cfd/uc01b_2.4x3.0lessmesh12cells/mesh/uc01b_cht_less_12y.msh}
set uns {D:/agents2026/agents2026/agents/AIDCtms/coolingplate/design/cfd/uc01b_2.4x3.0lessmesh12cells/icem/uc01b_cht_less_12y.uns}
set rf {E:/cae/programfiles/Ansys2026/ANSYS Inc261/v261/icemcfd/win64_amd/icemcfd/result-interfaces/readfluent.exe}
puts "Y12-VIEW msh=$msh exists=[file exists $msh]"
catch { ic_unload_mesh }
set ok 0
if {[file exists $rf] && [file exists $msh]} {
    if {![catch { ic_read_external $rf $msh 1 2 0 "" } err]} {
        set ok 1
        puts "Y12-VIEW readfluent ok"
    } else {
        puts "Y12-VIEW readfluent FAILED: $err"
    }
}
if {$ok} {
    catch { ic_save_unstruct $uns }
    catch { ic_uns_set_display_mode solid_and_wire }
    catch { ic_fit_view }
    catch { ic_redraw }
}
puts "Y12-VIEW done ok=$ok"
